{# Delivery component of a Crossplane instance: the Argo CD Application that applies its manifests (the XR). #}
{# They are the instance's main component, by convention in resources/<resource_id>. #}
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ resource_id | dump }}
  namespace: argocd
spec:
  project: {{ argo.project | dump }}
  source:
    repoURL: {{ argo.repo_url | dump }}
    targetRevision: {{ argo.target_revision | dump }}
    path: {{ ("resources/" + resource_id) | dump }}
    # metadata.yaml is written by the platform process, not a Kubernetes object
    directory:
      exclude: metadata.yaml
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argo.destination_namespace | dump }}
  # No automated sync: deploying a Crossplane resource means syncing this Application (future deploy pipeline).
  syncPolicy:
    syncOptions:
      - CreateNamespace=true
