# Values of the Argo CD chart, under its dependency name.
{{ argo.chart }}:
  configs:
    # The platform repository is public: registering it needs no credentials.
    repositories:
      demo-git-repo:
        type: git
        url: {{ argo.repo_url | dump }}
    # Initial password of "admin" (bcrypt hash, from the security office's interface): set at bootstrap,
    # so the chart does not leave it to the generated argocd-initial-admin-secret.
    secret:
      argocdServerAdminPassword: {{ argo_security.admin_password_bcrypt | dump }}
  # Reachable on the host, like the port-forward of infra/k8s/setup.sh: https://localhost:{{ argo.ui_port }}
  server:
    service:
      type: LoadBalancer
      servicePortHttps: {{ argo.ui_port }}
      servicePortHttp: {{ argo.ui_http_port }}
