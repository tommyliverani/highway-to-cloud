{# Only the fields this operation changes: the process merges them onto the existing S3Bucket XR #}
{# The Backstage form uses implementation-neutral names: they are mapped to S3 storage classes here #}
{% set storage_classes = {"infrequent_access": "STANDARD_IA", "intelligent_tiering": "INTELLIGENT_TIERING", "archive": "GLACIER", "deep_archive": "DEEP_ARCHIVE"} %}
spec:
  lifecycleRuleEnabled: true
  lifecycleTransitionDays: {{ (parameters.transition_days or 0) | int }}
  lifecycleTransitionStorageClass: {{ (storage_classes[parameters.transition_storage] or "STANDARD_IA") | dump }}
  lifecycleExpirationDays: {{ (parameters.expiration_days or 0) | int }}
  lifecycleNoncurrentVersionExpirationDays: {{ platform.lifecycle_noncurrent_version_expiration_days | int }}
  lifecycleAbortMultipartDays: {{ platform.lifecycle_abort_multipart_days | int }}
