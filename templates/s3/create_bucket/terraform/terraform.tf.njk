terraform {
  required_version = ">= 1.10.0"

  # Backend blocks cannot use variables: the values are written here when the resource is rendered.
  backend "s3" {
    bucket       = {{ tf_backend.state_bucket | dump }}
    region       = {{ tf_backend.state_region | dump }}
    key          = {{ ("resources/" + parameters.name + "/terraform.tfstate") | dump }}
    use_lockfile = true
  }
}
